# ==========================================================================
# Environment variables for Weather Monitoring IoT.
# Copy to `.env` and adjust. Docker Compose reads this automatically.
# For local (non-Docker) runs, export these or use localhost defaults.
# ==========================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=weather_data
KAFKA_TOPIC_ALERTS=weather_alerts
KAFKA_TOPIC_PERFORMANCE=performance_metrics

# --- Cassandra ---
CASSANDRA_HOST=cassandra
CASSANDRA_KEYSPACE=weather_ks

# --- Spark ---
SPARK_CHECKPOINT_DIR=stream-processing/checkpoints
SPARK_TRIGGER_INTERVAL=5 seconds

# --- Optimization knobs (all optional; sensible defaults in code) ---
# Spark
SPARK_SHUFFLE_PARTITIONS=4
CASS_CONCURRENT_WRITES=4          # parallel Cassandra writes
CASS_BATCH_SIZE_ROWS=200          # rows per Cassandra write batch
# MAX_OFFSETS_PER_TRIGGER=5000    # back-pressure: cap records per micro-batch
# Kafka producer (simulator)
PRODUCER_LINGER_MS=10             # batching window (higher = more throughput)
PRODUCER_BATCH_SIZE=32768         # producer batch bytes
PRODUCER_COMPRESSION=gzip         # gzip | lz4 | snappy | none
PRODUCER_ACKS=1                   # 1 = leader ack (fast); all = safest

# --- Simulator API ---
# Internal URL for container-to-container calls (dashboard -> simulator-api)
SIMULATOR_API_URL=http://simulator-api:8000
# Browser-accessible URL shown as a clickable link in the dashboard sidebar
SIMULATOR_API_PUBLIC_URL=http://localhost:8000/docs
SIMULATOR_API_PORT=8000

# --- Mobile dashboard (PWA) ---
MOBILE_API_PORT=8600

# ==========================================================================
# Local-run overrides (uncomment when NOT using Docker):
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# CASSANDRA_HOST=127.0.0.1
# SIMULATOR_API_URL=http://localhost:8000
# SIMULATOR_API_PUBLIC_URL=http://localhost:8000/docs
# ==========================================================================
